# /mnt/agent-config/.env
# Copy this to your TrueNAS dataset and fill in values
# Mount this file as /mnt/agent-config/.env in the custom app

# ── Required ──────────────────────────────────────────────────

# GitHub personal access token
# Needs: repo, issues, pull_requests scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Your GitHub repo (org/name or user/name)
GITHUB_REPO=myorg/my-android-app

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your personal Telegram chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=123456789

# Anthropic API key (from console.anthropic.com)
# Required for headless Claude Code in containers
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Optional ──────────────────────────────────────────────────

# GitHub issue label that triggers the agent (default: claude)
CLAUDE_ISSUE_LABEL=claude

# How often to poll GitHub for new issues, in seconds (default: 300)
POLL_INTERVAL_SECONDS=300

# Android app package name (used by QA agent for adb commands)
APP_PACKAGE=com.example.myapp

# Android app main activity (used to launch app in QA)
APP_ACTIVITY=com.example.myapp.MainActivity
